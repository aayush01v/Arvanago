rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isEmailVerified() { return request.auth != null && request.auth.token.email_verified == true; }

    // 1. USERS
    match /users/{userId} {
      // Public profiles are visible only when explicitly public.
      // Owner/admin can always read.
      allow read: if isOwner(userId) || isAdmin() || resource.data.isPublic == true;
      allow create: if isOwner(userId);
      // Allow update:
      // 1. Own profile (except role + follower counters reserved for trusted backend)
      // 2. Admin
      allow update: if 
        (isOwner(userId) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.followers == resource.data.followers &&
         request.resource.data.following == resource.data.following) || 
        isAdmin() ||
        false;
      allow delete: if isAdmin();

      // Follow System Subcollections (Nested)
      match /following/{followingId} {
        allow read: if true;
        // Client can only create/delete own outgoing follows.
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
      match /followers/{followerId} {
        allow read: if true;
        // Client can only create/delete their own follower edge.
        allow create, delete: if isAuthenticated() && request.auth.uid == followerId;
        allow update: if false;
      }
      
      // Notes & Vaults
      match /vaults/{vaultId} {
        allow read, write: if isOwner(userId);
      }
      match /notes/{noteId} {
        allow read: if isOwner(userId) || resource.data.isPublic == true;
        allow write: if isOwner(userId);
      }
    }

    // 2. ADMINS
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // 3. SETTINGS
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. COURSES (Original Rules Preserved)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      match /lectures/{lectureId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /doubts/{doubtId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }
    
    // 5. CALLS (WebRTC Signaling)
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // 6. CHATS
    match /chats/{chatId} {
      // Only allow creating chats with exactly 2 participants, one being the creator
      allow create: if isEmailVerified() && 
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.participants.hasAll([request.auth.uid]);
      allow read: if isEmailVerified() && (resource == null || resource.data.participants.hasAny([request.auth.uid]));
      allow update, delete: if isEmailVerified() && resource.data.participants.hasAny([request.auth.uid]);
      
      match /messages/{messageId} {
         allow read, write: if isEmailVerified() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // 6. POSTS
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Owner can update/delete full document
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Owner can update content. ANY authenticated user can update likes/commentsCount (for transactions)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount', 'updatedAt'])
      );

      match /likes/{userId} {
         allow read: if true;
         allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /comments/{commentId} {
         allow read: if true;
         allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
         // Allow delete by comment author OR post author
         allow delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid || 
            get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
         );
      }
    }

    // 7. NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // 8. LEADERBOARD
     match /leaderboard/{docId} {
      allow read: if isAuthenticated();
    }
    
    // 9. BLOG POSTS
    // 9. BLOG POSTS
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Allow admin to update fully. Allow authenticated users to update LIKES and COMMENTS COUNT.
      allow update: if isAdmin() || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount', 'updatedAt'])
      );
      
      match /comments/{commentId} {
         allow read: if true;
         allow create: if isAuthenticated(); 
         // Allow admin or owner to delete/edit text. Allow any auth user to toggle LIKES.
         allow update: if isAdmin() || 
                       (isAuthenticated() && resource.data.user.uid == request.auth.uid) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies']));
         allow delete: if isAdmin() || (isAuthenticated() && resource.data.user.uid == request.auth.uid);
      }
    }

    // 10. COUPONS
    match /coupons/{couponId} {
      // Anyone can read (to validate)
      allow read: if true;
      
      // Only admins can create or delete
      allow create, delete: if isAdmin();
      
      // Admins can update anything. 
      // Authenticated users can ONLY update 'usageCount' (when applying/using a coupon)
      allow update: if isAdmin() || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );
    }
    
    // 11. COLLECTION GROUP QUERIES (NOTES)
    match /{path=**}/notes/{noteId} {
      allow read: if resource.data.isPublic == true;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
