rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles:
    // - Any authenticated user can read profiles (for search/chat).
    // - Users can only write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats:
    // - Users can create a chat if they are a participant.
    // - Users can read/update chats where they are a participant.
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // Messages Subcollection:
      // - Users can read/write messages if they are a participant of the parent chat.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
