rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() { return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 1. USERS
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // Allow update:
      // 1. Own profile (except role)
      // 2. Admin
      // 3. ANY logged in user can update 'followers' count (needed for Follow feature)
      allow update: if 
        (isOwner(userId) && request.resource.data.role == resource.data.role) || 
        isAdmin() ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));
      allow delete: if isAdmin();

      // Follow System Subcollections (Nested)
      match /following/{followingId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow read: if true;
        // Allow write if the authenticated user is adding specifically THEMSELVES as a follower.
        allow write: if isAuthenticated() && request.auth.uid == followerId;
      }
    }

    // 2. ADMINS
    match /admins/{adminId} {
      allow read: if request.auth.uid == adminId || isAdmin();
      allow write: if isAdmin();
    }

    // 3. SETTINGS
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. COURSES (Original Rules Preserved)
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      match /lectures/{lectureId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /doubts/{doubtId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // 5. CHATS
    match /chats/{chatId} {
      allow create: if isAuthenticated() && request.resource.data.participants.hasAll([request.auth.uid]);
      allow read: if isAuthenticated() && (resource == null || resource.data.participants.hasAny([request.auth.uid]));
      allow update, delete: if isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]);
      
      match /messages/{messageId} {
         allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // 6. POSTS
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Owner can update/delete full document
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Owner can update content. ANY authenticated user can update likes/commentsCount (for transactions)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount', 'updatedAt'])
      );

      match /likes/{userId} {
         allow read: if true;
         allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /comments/{commentId} {
         allow read: if true;
         allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
         // Allow delete by comment author OR post author
         allow delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid || 
            get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
         );
      }
    }

    // 7. NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // 8. LEADERBOARD
     match /leaderboard/{docId} {
      allow read: if isAuthenticated();
    }
    
    // 9. BLOG POSTS
    // 9. BLOG POSTS
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Allow admin to update fully. Allow authenticated users to update LIKES and COMMENTS COUNT.
      allow update: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount', 'updatedAt'])
        )
      );
      
      match /comments/{commentId} {
         allow read: if true;
         allow create: if isAuthenticated(); 
         // Allow admin or owner to delete/edit text. Allow any auth user to toggle LIKES.
         allow update: if isAdmin() || 
                       (isAuthenticated() && resource.data.user.uid == request.auth.uid) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replies']));
         allow delete: if isAdmin() || (isAuthenticated() && resource.data.user.uid == request.auth.uid);
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}