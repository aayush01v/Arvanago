VIMEO_CLIENT_ID=your_client_id_here
VIMEO_CLIENT_SECRET=your_client_secret_here
VIMEO_ACCESS_TOKEN=your_access_token_here

VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Firebase Web API key (regenerate after the leak — see security issue #1)
# Used by firebaseConfig.ts. NEVER commit the real value.
VITE_FIREBASE_API_KEY=your-firebase-api-key-here

# GCP service account for Node scripts (scripts/*.js):
# Download a NEW service account key from GCP IAM (the leaked one must be revoked),
# store it OUTSIDE the repository, and point to it via:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
